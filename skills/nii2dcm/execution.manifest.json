{
  "schema_version": 1,
  "manifest_kind": "execution",
  "skill_id": "nii2dcm",
  "provides": [
    {
      "capability": "skill.nii2dcm",
      "method_id": "nii2dcm-local-environment",
      "label": "nii2dcm 实际转换",
      "description": "把一个 3D NIfTI 转换为研究用途的单帧 DICOM 序列；可从参考 DICOM 复制元数据。",
      "runner_id": "nii2dcm.convert",
      "execution_mode": "runner",
      "input_types": ["dataset_folder", "imaging_input"],
      "output_types": ["generated_folder", "execution_log"],
      "default_recommended": true,
      "default_reason": "配置已有 nii2dcm 环境后可直接启用；当前环境缺失时会明确禁用。",
      "parameters": [
        {"id": "dicom_type", "argument": "dicom-type", "label": "DICOM 类型", "description": "MR 和 SVR 会写入相应模态元数据；Generic 使用基础转换。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "MR", "options": [{"value": "MR", "label": "MR"}, {"value": "SVR", "label": "SVR"}, {"value": "generic", "label": "Generic"}]},
        {"id": "copy_reference_metadata", "argument": "ref-dicom", "label": "复制参考 DICOM 元数据", "description": "仅在明确需要保留研究元数据时启用；输出仍须人工检查。", "type": "boolean", "control": "switch", "level": "advanced", "group": "元数据", "required": true, "default": false}
      ],
      "input_slots": [
        {"id": "nifti", "type": "imaging_input", "label": "3D NIfTI", "description": "待转换的单个 3D .nii 或 .nii.gz；不支持 4D DWI/fMRI。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "reference_dicom", "type": "imaging_input", "label": "参考 DICOM", "description": "复制参考元数据时使用的一个 DICOM 文件。", "required": false, "required_when": {"copy_reference_metadata": [true]}, "binding": "file", "formats": [".dcm"], "source_options": ["dataset", "existing_path"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "dicom_series", "type": "generated_folder", "label": "DICOM 序列", "description": "逐切片 DICOM 输出目录，仅供研究和查看验证。", "primary": true, "path_template": "dicom-series/"},
        {"id": "log", "type": "execution_log", "label": "转换日志", "description": "nii2dcm 完整输出。", "path_template": "nii2dcm.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [{"path": "skills/nii2dcm/SKILL.md", "label": "nii2dcm Skill", "kind": "skill", "line_start": 1}]
    }
  ]
}
