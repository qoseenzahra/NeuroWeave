{
  "schema_version": 1,
  "manifest_kind": "execution",
  "skill_id": "nibabel-skill",
  "provides": [
    {
      "capability": "skill.nibabel-skill",
      "method_id": "nifti-inspect",
      "label": "Nibabel NIfTI 实际检查",
      "description": "读取 NIfTI 头、维度、数据类型、体素尺寸与仿射矩阵，并可保存规范化副本。",
      "runner_id": "nibabel.inspect",
      "execution_mode": "runner",
      "input_types": ["dataset_folder", "imaging_input"],
      "output_types": ["execution_log", "generated_file"],
      "default_recommended": true,
      "default_reason": "轻量检查不会修改输入影像，适合在处理前确认文件空间信息。",
      "parameters": [
        {"id": "save_copy", "argument": "copy-output", "label": "保存 NIfTI 副本", "description": "使用 nibabel 重新写出一份影像到隔离输出目录；默认只检查。", "type": "boolean", "control": "switch", "level": "basic", "group": "输出", "required": true, "default": false}
      ],
      "input_slots": [
        {"id": "image", "type": "imaging_input", "label": "NIfTI 影像", "description": "要检查的 .nii 或 .nii.gz 文件。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "inspection", "type": "execution_log", "label": "NIfTI 头信息", "description": "头、维度、数据类型、体素尺寸和仿射矩阵。", "primary": true, "path_template": "nifti-inspection.log"},
        {"id": "copy", "type": "generated_file", "label": "NIfTI 副本", "description": "可选重新写出的影像。", "path_template": "nifti-copy.nii.gz", "generated_when": {"save_copy": [true]}}
      ],
      "structure_level": "reviewed",
      "source_references": [
        {"path": "skills/nibabel-skill/scripts/nifti_inspection_reference.py", "label": "Nibabel 实现脚本", "kind": "script", "line_start": 1},
        {"path": "skills/nibabel-skill/SKILL.md", "label": "Nibabel Skill", "kind": "skill", "line_start": 1}
      ]
    }
  ]
}
