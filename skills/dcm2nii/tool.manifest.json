{
  "schema_version": 1,
  "skill_id": "dcm2nii",
  "provides": [
    {
      "capability": "skill.dcm2nii",
      "method_id": "dcm2niix-convert",
      "label": "dcm2niix 实际转换",
      "description": "调用服务器现有 dcm2niix，将只读 DICOM 输入转换到隔离输出目录并生成 JSON sidecar。",
      "runner_id": "dcm2niix.convert",
      "execution_mode": "runner",
      "input_types": ["dataset_folder"],
      "output_types": ["generated_folder", "execution_log"],
      "default_recommended": true,
      "default_reason": "服务器已检测到 dcm2niix，适合把 DICOM 序列转换为 NIfTI。",
      "parameters": [
        {"id": "compression", "argument": "-z", "label": "压缩方式", "description": "y 使用 gzip 压缩；n 输出未压缩 NIfTI；i 使用内部压缩。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "y", "options": [{"value": "y", "label": "GZip"}, {"value": "n", "label": "不压缩"}, {"value": "i", "label": "内部压缩"}]},
        {"id": "bids_sidecar", "argument": "-b", "label": "生成 BIDS JSON", "description": "为每个序列输出包含采集元数据的 JSON sidecar。", "type": "boolean", "control": "switch", "level": "basic", "group": "常用参数", "required": true, "default": true},
        {"id": "anonymize", "argument": "-ba", "label": "匿名化 sidecar", "description": "移除 dcm2niix 支持匿名化的个人标识字段。", "type": "boolean", "control": "switch", "level": "advanced", "group": "隐私", "required": true, "default": true},
        {"id": "filename_template", "argument": "-f", "label": "文件名模板", "description": "dcm2niix 文件名占位符；不允许路径分隔符或上级目录。", "type": "string", "control": "text", "level": "advanced", "group": "输出命名", "required": true, "default": "%p_%s", "placeholder": "%p_%s"}
      ],
      "input_slots": [
        {"id": "dicom_directory", "type": "dataset_folder", "label": "DICOM 目录", "description": "包含一个或多个 DICOM 序列的目录；源目录只读。", "required": true, "binding": "folder", "source_options": ["dataset", "existing_path"], "validation": ["path_exists", "within_authorized_root"]}
      ],
      "output_slots": [
        {"id": "converted", "type": "generated_folder", "label": "NIfTI 转换目录", "description": "转换后的 NIfTI、JSON 与扩散梯度文件。", "primary": true, "path_template": "converted-nifti/"},
        {"id": "log", "type": "execution_log", "label": "转换日志", "description": "dcm2niix 完整输出。", "path_template": "dcm2niix.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [
        {"path": "skills/dcm2nii/SKILL.md", "label": "dcm2nii Skill", "kind": "skill", "line_start": 1}
      ]
    }
  ]
}
