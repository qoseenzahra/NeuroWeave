{
  "schema_version": 1,
  "id": "ixi-skill",
  "description": "IXI 数据集专属适配，按该数据集的命名、目录或表字段约定选择处理方法。支持：ixi 质控汇总；ixi 复制整理为 BIDS 目录；FSL 完整结构预处理（fsl_anat）；FreeSurfer recon-all（可执行）。",
  "method_refs": [
    {
      "capability": "skill.ixi-skill",
      "method_id": "reviewed-ixi-qc-summary-ixi-skill",
      "label": "ixi 质控汇总",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "qc-summary"
      ],
      "execution_resolution": {},
      "role": "Generate per-subject QC summaries for IXI processing. Multi-site aware: tracks site information and applies site-specific QC criteria。 Inputs: fmriprep_dir: Path to fMRIPrep output directory (directory); freesurfer_dir: Path to FreeSurfer output directory (directory). Registered outputs: results/output.csv.",
      "method_ref": "reviewed.ixi-skill.ixi-qc-summary"
    },
    {
      "capability": "skill.ixi-skill",
      "method_id": "reviewed-reorganize-ixi-ixi-skill",
      "label": "ixi 复制整理为 BIDS 目录",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "bids-reorganization",
        "data-reorganization"
      ],
      "execution_resolution": {},
      "role": "Reorganize IXI native layout to BIDS structure. Converts IXI directory layout (e.g., IXI002/, IXI002-T1.nii.gz, IXI002-T2.nii.gz) to BIDS-style structure (sub-IXI002/anat/)。 Inputs: input: Path to IXI raw directory (directory). Registered outputs: results/.",
      "method_ref": "reviewed.ixi-skill.reorganize-ixi"
    },
    {
      "capability": "skill.ixi-skill",
      "method_id": "ixi-skill-guided--smri-processing--via-reviewed-fsl-anat-fsl-tool",
      "label": "FSL 完整结构预处理（fsl_anat）",
      "default_recommended": false,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {
        "state": "mapped",
        "reason": "选择原文委托的具体结构处理入口；不同流程分别列出，按用户所需范围执行。",
        "source_method_id": "ixi-skill-guided--smri-processing",
        "target_method_id": "reviewed-fsl-anat-fsl-tool"
      },
      "role": "Invoke the existing FSL fsl_anat workflow on a T1-weighted image and retain its structural.anat directory, including the bias-corrected brain image。 Inputs: input: T1w NIfTI (file). Registered outputs: results/structural.anat/T1_biascorr_brain.nii.gz. Fixed invocation options: --operation fsl-anat.",
      "method_ref": "reviewed.fsl-tool.fsl-anat"
    }
  ],
  "pipeline_refs": [
    {
      "capability": "skill.ixi-skill",
      "method_id": "ixi-skill-guided--smri-processing--via-freesurfer-recon-all-all",
      "label": "FreeSurfer recon-all（可执行）",
      "default_recommended": false,
      "default_reason": "当用户明确要求 FreeSurfer 分割/皮层重建且已提供 T1w 时，选择服务器已验证的 recon-all Runner。",
      "replaces_operations": [],
      "execution_resolution": {
        "state": "mapped",
        "reason": "选择原文委托的具体结构处理入口；不同流程分别列出，按用户所需范围执行。",
        "source_method_id": "ixi-skill-guided--smri-processing",
