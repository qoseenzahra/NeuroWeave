{
  "schema_version": 1,
  "skill_id": "freesurfer-tool",
  "provides": [
    {
      "capability": "skill.freesurfer-tool",
      "method_id": "freesurfer-recon-all",
      "label": "FreeSurfer recon-all（可执行）",
      "description": "使用服务器现有 FreeSurfer 7.4.1 执行完整 recon-all，或在同一 SUBJECTS_DIR 中连续执行 autorecon1/2/3，并登记受试者目录制品。",
      "runner_id": "freesurfer.recon_all",
      "execution_mode": "runner",
      "input_types": ["t1w_image"],
      "output_types": ["freesurfer_subject"],
      "requires_features": ["has_t1w"],
      "default_recommended": true,
      "default_reason": "当用户明确要求 FreeSurfer 分割/皮层重建且已提供 T1w 时，选择服务器已验证的 recon-all Runner。",
      "structure_level": "reviewed",
      "input_slots": [
        {"id": "t1w", "type": "t1w_image", "label": "T1w 输入", "description": "autorecon1 或 all 的原始全头 T1w；脑提取后的 T1w 可能影响颅骨剥离和表面重建。", "required": false, "required_when": {"processing_stage": ["autorecon1", "all"]}, "binding": "file", "formats": [".nii", ".nii.gz", ".mgz"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "subject", "type": "freesurfer_subject", "label": "已有 FreeSurfer 受试者目录", "description": "autorecon2、autorecon3 或 stats 续跑时使用；由同一执行配方的上一步自动绑定。", "required": false, "required_when": {"processing_stage": ["autorecon2", "autorecon3", "stats"]}, "binding": "folder", "source_options": ["existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "t2w", "type": "imaging_input", "label": "可选 T2w", "description": "启用 T2 pial refinement 时提供。", "required": false, "required_when": {"use_t2": [true]}, "binding": "file", "formats": [".nii", ".nii.gz", ".mgz"], "source_options": ["dataset", "existing_path"], "validation": ["path_exists"]},
        {"id": "flair", "type": "imaging_input", "label": "可选 FLAIR", "description": "启用 FLAIR pial refinement 时提供。", "required": false, "required_when": {"use_flair": [true]}, "binding": "file", "formats": [".nii", ".nii.gz", ".mgz"], "source_options": ["dataset", "existing_path"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "subject", "type": "freesurfer_subject", "label": "FreeSurfer 受试者目录", "description": "包含 mri、surf、label、stats 等输出。", "primary": true, "path_template": "{subject}/"}
      ],
      "parameters": [
        {"id": "processing_stage", "argument": "stage", "label": "处理范围", "description": "all/autorecon1 从 T1w 开始；autorecon2、autorecon3 和 stats 必须从已有受试者目录续跑。", "type": "string", "control": "select", "level": "basic", "group": "处理范围", "required": true, "default": "all", "options": [{"value": "autorecon1", "label": "autorecon1：体数据准备"}, {"value": "autorecon2", "label": "autorecon2：白质与表面"}, {"value": "autorecon3", "label": "autorecon3：配准、分区与统计"}, {"value": "stats", "label": "仅重建统计"}, {"value": "all", "label": "完整 recon-all"}]},
        {"id": "threads", "argument": "openmp", "label": "OpenMP 线程数", "description": "recon-all 可使用的 CPU 线程数。", "type": "integer", "control": "number", "level": "basic", "group": "计算资源", "required": true, "default": 4, "minimum": 1, "maximum": 32, "step": 1},
        {"id": "use_t2", "argument": "T2pial", "label": "使用 T2 优化 pial 面", "description": "启用后必须绑定 T2w。", "type": "boolean", "control": "switch", "level": "advanced", "group": "辅助模态", "required": true, "default": false, "options": [{"value": true, "label": "启用"}, {"value": false, "label": "关闭"}]},
        {"id": "use_flair", "argument": "FLAIRpial", "label": "使用 FLAIR 优化 pial 面", "description": "启用后必须绑定 FLAIR。", "type": "boolean", "control": "switch", "level": "advanced", "group": "辅助模态", "required": true, "default": false, "options": [{"value": true, "label": "启用"}, {"value": false, "label": "关闭"}]}
      ]
    }
  ]
}
