{
  "schema_version": 1,
  "skill_id": "freesurfer-tool",
  "recipes": [
    {
      "recipe_id": "freesurfer.full-pipeline",
      "label": "FreeSurfer 完整 recon-all",
      "operation_value": "full-pipeline-most-common",
      "interface_capability": "skill.freesurfer-tool",
      "interface_method_id": "freesurfer-recon-all",
      "exposed_parameters": ["threads", "use_t2", "use_flair"],
      "input_slots": [
        {
          "id": "t1w",
          "type": "t1w_image",
          "label": "T1w 输入",
          "description": "完整 recon-all 使用的原始全头 T1w。",
          "required": true,
          "binding": "file",
          "formats": [".nii", ".nii.gz", ".mgz"],
          "source_options": ["dataset", "existing_path", "upstream_output"],
          "validation": ["path_exists"]
        },
        {
          "id": "t2w",
          "type": "imaging_input",
          "label": "可选 T2w",
          "description": "启用 T2 pial refinement 时提供。",
          "required": false,
          "required_when": {"use_t2": [true]},
          "binding": "file",
          "formats": [".nii", ".nii.gz", ".mgz"],
          "source_options": ["dataset", "existing_path"],
          "validation": ["path_exists"]
        },
        {
          "id": "flair",
          "type": "imaging_input",
          "label": "可选 FLAIR",
          "description": "启用 FLAIR pial refinement 时提供。",
          "required": false,
          "required_when": {"use_flair": [true]},
          "binding": "file",
          "formats": [".nii", ".nii.gz", ".mgz"],
          "source_options": ["dataset", "existing_path"],
          "validation": ["path_exists"]
        }
      ],
      "steps": [
        {
          "id": "recon_all",
          "title": "FreeSurfer 完整 recon-all",
          "capability": "skill.freesurfer-tool",
          "method_id": "freesurfer-recon-all",
          "fixed_parameters": {"processing_stage": "all"},
          "input_bindings": {
            "t1w": {"source": "workflow_input", "slot_id": "t1w"},
            "t2w": {"source": "workflow_input", "slot_id": "t2w"},
            "flair": {"source": "workflow_input", "slot_id": "flair"}
          },
          "workspace": "subject"
        }
      ],
      "output_bindings": {
        "subject": {"step_id": "recon_all", "output_slot_id": "subject"}
      }
    },
    {
      "recipe_id": "freesurfer.autorecon-stages",
      "label": "FreeSurfer autorecon1 → autorecon2 → autorecon3",
      "operation_value": "fast-subcortical-basic-surfaces",
      "interface_capability": "skill.freesurfer-tool",
      "interface_method_id": "freesurfer-recon-all",
      "exposed_parameters": ["threads"],
      "input_slots": [
        {
          "id": "t1w",
          "type": "t1w_image",
          "label": "T1w 输入",
          "description": "只在 autorecon1 导入一次；后续阶段复用同一受试者目录。",
          "required": true,
          "binding": "file",
          "formats": [".nii", ".nii.gz", ".mgz"],
          "source_options": ["dataset", "existing_path", "upstream_output"],
          "validation": ["path_exists"]
        }
      ],
      "steps": [
        {
          "id": "autorecon1",
          "title": "FreeSurfer autorecon1",
          "capability": "skill.freesurfer-tool",
          "method_id": "freesurfer-recon-all",
          "fixed_parameters": {"processing_stage": "autorecon1"},
          "input_bindings": {
            "t1w": {"source": "workflow_input", "slot_id": "t1w"}
          },
          "workspace": "subject"
        },
        {
          "id": "autorecon2",
          "title": "FreeSurfer autorecon2",
          "capability": "skill.freesurfer-tool",
          "method_id": "freesurfer-recon-all",
          "fixed_parameters": {"processing_stage": "autorecon2"},
          "input_bindings": {
            "subject": {
              "source": "step_output",
              "step_id": "autorecon1",
              "output_slot_id": "subject"
            }
          },
          "workspace": "subject"
        },
        {
          "id": "autorecon3",
          "title": "FreeSurfer autorecon3",
          "capability": "skill.freesurfer-tool",
          "method_id": "freesurfer-recon-all",
          "fixed_parameters": {"processing_stage": "autorecon3"},
          "input_bindings": {
            "subject": {
              "source": "step_output",
              "step_id": "autorecon2",
              "output_slot_id": "subject"
            }
          },
          "workspace": "subject"
        }
      ],
      "output_bindings": {
        "subject": {"step_id": "autorecon3", "output_slot_id": "subject"}
      }
    }
  ]
}
