{
  "schema_version": 1,
  "manifest_kind": "execution",
  "skill_id": "pet-skill",
  "provides": [
    {
      "capability": "skill.pet-skill",
      "method_id": "compute-suvr",
      "label": "PET SUVR 实际定量",
      "description": "使用 Skill 自带且已审核的脚本，从 PET、参考区 Mask 和目标 Mask 计算 SUVR 表格与影像。",
      "runner_id": "pet.compute_suvr",
      "execution_mode": "runner",
      "input_types": ["dataset_folder", "imaging_input"],
      "output_types": ["generated_file", "execution_log"],
      "default_recommended": true,
      "default_reason": "服务器 Scientific Python 已满足 numpy 与 nibabel 依赖时可直接运行。",
      "parameters": [
        {"id": "frame", "argument": "frame", "label": "PET 帧", "description": "-1 对 4D PET 所有帧求平均；非负数选择指定帧。", "type": "integer", "control": "number", "level": "basic", "group": "常用参数", "required": true, "default": -1, "minimum": -1, "maximum": 10000, "step": 1}
      ],
      "input_slots": [
        {"id": "pet_image", "type": "imaging_input", "label": "PET 影像", "description": "3D 静态或 4D 动态 PET NIfTI。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "reference_mask", "type": "brain_mask", "label": "参考区 Mask", "description": "用于归一化的参考脑区，例如小脑皮层。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists", "spatially_compatible"]},
        {"id": "target_mask", "type": "target_mask", "label": "目标区 Mask", "description": "计算目标区平均 SUVR 与体素 SUVR 图。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists", "spatially_compatible"]}
      ],
      "output_slots": [
        {"id": "summary", "type": "generated_file", "label": "SUVR 汇总", "description": "目标区信号、参考区信号与 SUVR。", "primary": true, "path_template": "suvr.csv"},
        {"id": "map", "type": "generated_file", "label": "SUVR 影像", "description": "目标区体素 SUVR NIfTI。", "path_template": "suvr-map.nii.gz"},
        {"id": "log", "type": "execution_log", "label": "SUVR 日志", "description": "完整定量日志。", "path_template": "compute-suvr.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [
        {"path": "skills/pet-skill/scripts/compute_suvr.py", "label": "SUVR 实现脚本", "kind": "script", "line_start": 1},
        {"path": "skills/pet-skill/SKILL.md", "label": "PET Skill", "kind": "skill", "line_start": 1}
      ]
    }
  ]
}
