{
  "schema_version": 1,
  "manifest_kind": "execution",
  "skill_id": "dwi-skill",
  "provides": [
    {
      "capability": "dwi.response",
      "method_id": "mrtrix-dwi2response",
      "label": "MRtrix3 响应函数估计",
      "description": "使用 dwi2response 的 dhollander 或 tournier 算法生成 CSD 所需组织响应函数。",
      "runner_id": "mrtrix.dwi2response",
      "execution_mode": "runner",
      "input_types": ["preprocessed_dwi"],
      "output_types": ["response_functions", "execution_log"],
      "default_recommended": true,
      "default_reason": "在 FOD 估计之前生成经过记录的组织响应函数。",
      "parameters": [
        {"id": "algorithm", "argument": "algorithm", "label": "响应函数算法", "description": "Dhollander 适用于多组织估计；Tournier 生成单组织白质响应。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "dhollander", "options": [{"value": "dhollander", "label": "Dhollander（多组织）"}, {"value": "tournier", "label": "Tournier（单组织）"}]},
        {"id": "threads", "argument": "nthreads", "label": "线程数", "description": "MRtrix3 使用的 CPU 线程数。", "type": "integer", "control": "number", "level": "advanced", "group": "计算资源", "required": true, "default": 4, "minimum": 1, "maximum": 128, "step": 1}
      ],
      "input_slots": [
        {"id": "dwi", "type": "preprocessed_dwi", "label": "预处理 DWI", "description": "完成畸变与运动校正的 4D DWI。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz", ".mif"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "mask", "type": "brain_mask", "label": "DWI Mask", "description": "与 DWI 空间一致的脑掩膜。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz", ".mif"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "bvecs", "type": "gradient_table", "label": "bvec", "description": "FSL 格式梯度方向。", "required": true, "binding": "file", "formats": [".bvec", ".txt"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "bvals", "type": "gradient_table", "label": "bval", "description": "扩散梯度强度。", "required": true, "binding": "file", "formats": [".bval", ".txt"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "wm_response", "type": "response_functions", "label": "白质响应函数", "description": "CSD 白质响应函数。", "primary": true, "path_template": "wm_response.txt"},
        {"id": "gm_response", "type": "response_functions", "label": "灰质响应函数", "description": "Dhollander 多组织灰质响应函数。", "path_template": "gm_response.txt", "generated_when": {"algorithm": ["dhollander"]}},
        {"id": "csf_response", "type": "response_functions", "label": "脑脊液响应函数", "description": "Dhollander 多组织脑脊液响应函数。", "path_template": "csf_response.txt", "generated_when": {"algorithm": ["dhollander"]}},
        {"id": "log", "type": "execution_log", "label": "响应函数日志", "description": "dwi2response 完整输出。", "path_template": "dwi2response.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [{"path": "skills/dwi-skill/SKILL.md", "label": "DWI Skill", "kind": "skill", "line_start": 1}]
    },
    {
      "capability": "dwi.fod",
      "method_id": "mrtrix-dwi2fod",
      "label": "MRtrix3 CSD / MSMT-CSD",
      "description": "使用 dwi2fod 从预处理 DWI 与组织响应函数估计白质 FOD。",
      "runner_id": "mrtrix.dwi2fod",
      "execution_mode": "runner",
      "input_types": ["response_functions"],
      "output_types": ["fod_image", "execution_log"],
      "default_recommended": true,
      "default_reason": "为 tckgen 生成真实可执行的 FOD 上游输入。",
      "parameters": [
        {"id": "algorithm", "argument": "algorithm", "label": "FOD 算法", "description": "单组织数据使用 CSD；多壳层多组织数据使用 MSMT-CSD。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "csd", "options": [{"value": "csd", "label": "CSD（单组织）"}, {"value": "msmt_csd", "label": "MSMT-CSD（多组织）"}]},
        {"id": "lmax", "argument": "lmax", "label": "球谐最高阶数", "description": "FOD 球谐展开的最大偶数阶。", "type": "integer", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": 8, "options": [{"value": 6, "label": "6"}, {"value": 8, "label": "8"}, {"value": 10, "label": "10"}, {"value": 12, "label": "12"}]},
        {"id": "threads", "argument": "nthreads", "label": "线程数", "description": "MRtrix3 使用的 CPU 线程数。", "type": "integer", "control": "number", "level": "advanced", "group": "计算资源", "required": true, "default": 4, "minimum": 1, "maximum": 128, "step": 1}
      ],
      "input_slots": [
        {"id": "dwi", "type": "preprocessed_dwi", "label": "预处理 DWI", "description": "与响应函数对应的 DWI。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz", ".mif"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "mask", "type": "brain_mask", "label": "DWI Mask", "description": "限制 FOD 估计范围。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz", ".mif"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "bvecs", "type": "gradient_table", "label": "bvec", "description": "FSL 格式梯度方向。", "required": true, "binding": "file", "formats": [".bvec", ".txt"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "bvals", "type": "gradient_table", "label": "bval", "description": "扩散梯度强度。", "required": true, "binding": "file", "formats": [".bval", ".txt"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "wm_response", "type": "response_functions", "label": "白质响应函数", "description": "dwi2response 生成的白质响应。", "required": true, "binding": "file", "formats": [".txt"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "gm_response", "type": "response_functions", "label": "灰质响应函数", "description": "仅 MSMT-CSD 必需。", "required": false, "required_when": {"algorithm": ["msmt_csd"]}, "binding": "file", "formats": [".txt"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "csf_response", "type": "response_functions", "label": "脑脊液响应函数", "description": "仅 MSMT-CSD 必需。", "required": false, "required_when": {"algorithm": ["msmt_csd"]}, "binding": "file", "formats": [".txt"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "wm_fod", "type": "fod_image", "label": "白质 FOD", "description": "可直接传给 tckgen。", "primary": true, "path_template": "wm_fod.mif"},
        {"id": "log", "type": "execution_log", "label": "FOD 日志", "description": "dwi2fod 完整输出。", "path_template": "dwi2fod.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [{"path": "skills/dwi-skill/SKILL.md", "label": "DWI Skill", "kind": "skill", "line_start": 1}]
    },
    {
      "capability": "dwi.five_tt",
      "method_id": "mrtrix-5ttgen-fsl",
      "label": "MRtrix3 5ttgen（FSL）",
      "description": "由 T1w 结构像生成 ACT 纤维追踪使用的五组织类型影像。",
      "runner_id": "mrtrix.5ttgen",
      "execution_mode": "runner",
      "input_types": ["t1w_image", "dataset_folder"],
      "output_types": ["five_tt_image", "execution_log"],
      "default_recommended": true,
      "default_reason": "服务器已有 MRtrix3 与 FSL，可直接生成 ACT 输入。",
      "parameters": [
        {"id": "algorithm", "argument": "algorithm", "label": "分割后端", "description": "当前可信入口固定使用 FSL 后端。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "fsl", "options": [{"value": "fsl", "label": "FSL"}]},
        {"id": "nocrop", "argument": "nocrop", "label": "不裁剪输出", "description": "保留 T1w 原始空间范围。", "type": "boolean", "control": "switch", "level": "advanced", "group": "输出", "required": true, "default": false},
        {"id": "threads", "argument": "nthreads", "label": "线程数", "description": "MRtrix3 使用的 CPU 线程数。", "type": "integer", "control": "number", "level": "advanced", "group": "计算资源", "required": true, "default": 4, "minimum": 1, "maximum": 128, "step": 1}
      ],
      "input_slots": [
        {"id": "t1w", "type": "t1w_image", "label": "T1w 结构像", "description": "用于组织分割的 3D T1w NIfTI。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "five_tt", "type": "five_tt_image", "label": "5TT 影像", "description": "ACT 追踪所需五组织类型影像。", "primary": true, "path_template": "5tt.mif"},
        {"id": "log", "type": "execution_log", "label": "5TT 日志", "description": "5ttgen 完整输出。", "path_template": "5ttgen.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [{"path": "skills/dwi-skill/SKILL.md", "label": "DWI Skill", "kind": "skill", "line_start": 1}]
    },
    {
      "capability": "dwi.connectome",
      "method_id": "mrtrix-tck2connectome",
      "label": "MRtrix3 tck2connectome",
      "description": "把流线与脑区分区映射为结构连接矩阵，可选使用 SIFT2 权重或标量边权。",
      "runner_id": "mrtrix.tck2connectome",
      "execution_mode": "runner",
      "input_types": ["tractogram"],
      "output_types": ["connectome", "generated_file", "execution_log"],
      "default_recommended": true,
      "default_reason": "纤维追踪后生成可审计的 ROI×ROI 连接矩阵。",
      "parameters": [
        {"id": "edge_weight", "argument": "edge-weight", "label": "边权类型", "description": "使用流线计数，或沿流线聚合标量影像。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "count", "options": [{"value": "count", "label": "流线计数"}, {"value": "mean_scalar", "label": "平均标量"}]},
        {"id": "use_weights", "argument": "tck-weights-in", "label": "使用 SIFT2 权重", "description": "按每条流线的 SIFT2 权重汇总连接。", "type": "boolean", "control": "switch", "level": "basic", "group": "常用参数", "required": true, "default": false},
        {"id": "symmetric", "argument": "symmetric", "label": "输出对称矩阵", "description": "将双向连接合并为对称矩阵。", "type": "boolean", "control": "switch", "level": "advanced", "group": "矩阵", "required": true, "default": true},
        {"id": "zero_diagonal", "argument": "zero-diagonal", "label": "对角线置零", "description": "清除同一节点内部的自连接。", "type": "boolean", "control": "switch", "level": "advanced", "group": "矩阵", "required": true, "default": true},
        {"id": "radial_search", "argument": "assignment-radial-search", "label": "端点径向搜索", "description": "端点未落入标签时的径向搜索距离。", "type": "number", "control": "number", "level": "advanced", "group": "节点分配", "unit": "mm", "required": true, "default": 2, "minimum": 0, "maximum": 10, "step": 0.5},
        {"id": "stat_edge", "argument": "stat-edge", "label": "边聚合统计", "description": "多条流线聚合到同一边时的统计方式。", "type": "string", "control": "select", "level": "advanced", "group": "矩阵", "required": true, "default": "sum", "options": [{"value": "sum", "label": "求和"}, {"value": "mean", "label": "平均"}, {"value": "min", "label": "最小"}, {"value": "max", "label": "最大"}]},
        {"id": "threads", "argument": "nthreads", "label": "线程数", "description": "MRtrix3 使用的 CPU 线程数。", "type": "integer", "control": "number", "level": "advanced", "group": "计算资源", "required": true, "default": 4, "minimum": 1, "maximum": 128, "step": 1}
      ],
      "input_slots": [
        {"id": "tractogram", "type": "tractogram", "label": "纤维流线", "description": "tckgen 生成的 .tck 文件。", "required": true, "binding": "file", "formats": [".tck"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "parcellation", "type": "parcellation_image", "label": "脑区分区图", "description": "与流线空间兼容的整数标签影像。", "required": true, "binding": "file", "formats": [".nii", ".nii.gz", ".mif"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "weights", "type": "streamline_weights", "label": "SIFT2 权重", "description": "仅启用 SIFT2 权重时必需。", "required": false, "required_when": {"use_weights": [true]}, "binding": "file", "formats": [".txt", ".csv"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]},
        {"id": "scalar", "type": "scalar_image", "label": "边权标量影像", "description": "仅使用平均标量边权时必需。", "required": false, "required_when": {"edge_weight": ["mean_scalar"]}, "binding": "file", "formats": [".nii", ".nii.gz", ".mif"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "connectome", "type": "connectome", "label": "结构连接矩阵", "description": "ROI×ROI CSV 矩阵。", "primary": true, "path_template": "connectome.csv"},
        {"id": "assignments", "type": "generated_file", "label": "流线节点分配", "description": "每条流线分配到的节点对。", "path_template": "assignments.txt"},
        {"id": "log", "type": "execution_log", "label": "连接组日志", "description": "tck2connectome 完整输出。", "path_template": "tck2connectome.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [{"path": "skills/dwi-skill/SKILL.md", "label": "DWI Skill", "kind": "skill", "line_start": 1}]
    }
  ]
}
