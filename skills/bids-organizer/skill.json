      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Generate dataset_description.json with the supplied dataset name and a staging report. This operation does not copy images or validate full BIDS compliance。 Inputs: input: 源数据集目录 (directory). Registered outputs: results/dataset_description.json, results/staging_report.json. Fixed invocation options: --operation metadata.",
      "method_ref": "reviewed.bids-organizer.explicit-metadata"
    },
    {
      "capability": "skill.bids-organizer",
      "method_id": "reviewed-explicit-stage-bids-organizer",
      "label": "按用户文件映射整理 BIDS（文件名检查）",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Copy files according to an explicit source-relative to BIDS-relative JSON mapping, check destination filenames with BIDSValidator, and write dataset metadata and a staging report. It does not infer missing entities or perform full dataset validation。 Inputs: input: 源数据集目录 (directory); mapping: 显式文件映射 JSON（源相对路径 → BIDS 相对路径） (file). Registered outputs: results/dataset_description.json, results/staging_report.json. Fixed invocation options: --operation stage.",
      "method_ref": "reviewed.bids-organizer.explicit-stage"
    },
