{
  "schema_version": 1,
  "skill_id": "bids-organizer",
  "provides": [
    {
      "capability": "skill.bids-organizer",
      "method_id": "reviewed-explicit-metadata-bids-organizer",
      "label": "BIDS 元数据生成",
      "description": "调用现有实现：json.dump, shutil.copyfile。输入保持只读，输出写入独立任务目录。",
      "runner_id": "reviewed.bids-organizer.explicit-metadata",
      "execution_mode": "runner",
      "structure_level": "reviewed",
      "parameters": [
        {
          "id": "name",
          "argument": "name",
          "label": "数据集名称",
          "type": "string",
          "default": "NeuroWeave dataset",
          "required": true,
          "options": [],
          "minimum": null,
          "maximum": null
        }
      ],
      "input_slots": [
        {
          "id": "input",
          "label": "源数据集目录",
          "required": true,
          "binding": "folder",
          "type": "analysis_input"
        }
      ],
      "output_slots": [
        {
          "id": "results",
          "type": "generated_folder",
          "label": "分析结果",
          "primary": true,
          "path_template": "results/"
        },
        {
          "id": "file_dataset_description_json",
          "type": "generated_file",
          "label": "dataset_description.json",
          "path_template": "results/dataset_description.json"
        },
        {
          "id": "file_staging_report_json",
          "type": "generated_file",
          "label": "staging_report.json",
          "path_template": "results/staging_report.json"
        }
      ],
      "input_types": [
        "analysis_input"
      ],
      "output_types": [
        "generated_folder"
      ],
      "default_recommended": true,
      "replaces_operations": [],
      "source_references": [
        {
          "path": "bakend/app/execution/bids_mapping_worker.py",
          "kind": "script",
          "label": "现有实现调用入口",
          "line_start": 1
        },
        {
          "path": "bakend/resources/existing_implementation_sources.json",
          "kind": "script",
          "label": "实现来源与原始源码校验记录",
          "line_start": 1
        }
      ]
    },
    {
      "capability": "skill.bids-organizer",
      "method_id": "reviewed-explicit-stage-bids-organizer",
      "label": "按用户文件映射整理 BIDS（文件名检查）",
      "description": "调用现有实现：json.dump, shutil.copyfile, bids_validator.BIDSValidator.is_bids。输入保持只读，输出写入独立任务目录。",
      "runner_id": "reviewed.bids-organizer.explicit-stage",
      "execution_mode": "runner",
      "structure_level": "reviewed",
      "parameters": [
        {
          "id": "name",
          "argument": "name",
          "label": "数据集名称",
          "type": "string",
          "default": "NeuroWeave dataset",
          "required": true,
          "options": [],
          "minimum": null,
          "maximum": null
        }
      ],
      "input_slots": [
        {
          "id": "input",
          "label": "源数据集目录",
          "required": true,
          "binding": "folder",
          "type": "analysis_input"
        },
        {
          "id": "mapping",
          "label": "显式文件映射 JSON（源相对路径 → BIDS 相对路径）",
          "required": true,
          "binding": "file",
          "type": "analysis_input"
        }
      ],
      "output_slots": [
        {
          "id": "results",
          "type": "generated_folder",
          "label": "分析结果",
          "primary": true,
          "path_template": "results/"
        },
        {
          "id": "file_dataset_description_json",
          "type": "generated_file",
          "label": "dataset_description.json",
          "path_template": "results/dataset_description.json"
        },
        {
          "id": "file_staging_report_json",
          "type": "generated_file",
          "label": "staging_report.json",
          "path_template": "results/staging_report.json"
        }
      ],
      "input_types": [
        "analysis_input"
      ],
      "output_types": [
        "generated_folder"
      ],
      "default_recommended": true,
      "replaces_operations": [],
      "source_references": [
        {
          "path": "bakend/app/execution/bids_mapping_worker.py",
          "kind": "script",
          "label": "现有实现调用入口",
          "line_start": 1
        },
        {
          "path": "bakend/resources/existing_implementation_sources.json",
          "kind": "script",
          "label": "实现来源与原始源码校验记录",
          "line_start": 1
        }
      ]
    },
    {
      "capability": "skill.bids-organizer",
      "method_id": "linked-bids_organizer",
      "label": "BIDS Organizer",
      "description": "把已有 NIfTI/BIDS 数据复制到隔离输出目录，补齐 dataset_description.json、清理敏感 sidecar 字段并执行基础结构校验。DICOM 应先使用 dcm2niix 转换。",
      "runner_id": "bids.prepare",
      "input_types": [
        "dataset_folder",
        "raw_dwi",
        "bids_dwi"
      ],
      "output_types": [
        "bids_dwi",
        "generated_file"
      ],
      "input_slots": [
        {
          "id": "source_dataset",
          "type": "dataset_folder",
          "label": "NIfTI/BIDS 源目录",
          "description": "包含 NIfTI 与可选 BIDS sidecar 的源目录；DICOM 数据请先运行 dcm2niix。",
          "required": true,
          "binding": "folder",
          "source_options": [
            "dataset",
            "existing_path"
          ],
          "validation": [
            "path_exists",
            "inside_authorized_root"
          ]
        }
      ],
      "output_slots": [
        {
          "id": "bids_dataset",
          "type": "bids_dwi",
          "label": "BIDS 数据集副本",
          "description": "经过复制、元数据清理和基础验证的数据集。",
          "primary": true,
          "path_template": "bids/"
        },
        {
          "id": "validation_report",
          "type": "generated_file",
          "label": "BIDS 校验报告",
          "description": "受试者数、影像数、匿名化字段数和结构问题。",
          "path_template": "bids-validation.json"
        }
      ],
      "default_recommended": false,
      "default_reason": "标准化输入可以减少预处理工具之间的差异。",
      "parameters": [
        {
          "id": "validation_level",
          "argument": "validation-level",
          "label": "BIDS 验证级别",
          "description": "严格模式在没有 sub-* 或 NIfTI 时停止；基础模式复制并在报告中记录问题。",
          "type": "string",
          "control": "select",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": "strict",
          "options": [
            {
              "value": "basic",
              "label": "基础检查并保留报告"
            },
            {
              "value": "strict",
              "label": "严格检查，失败即停止"
            }
          ]
        },
        {
          "id": "anonymize_metadata",
          "argument": "anonymize-metadata",
          "label": "清理敏感元数据",
          "description": "只在输出副本中移除常见 Patient、Institution、Physician 和日期字段。",
          "type": "boolean",
          "control": "switch",
          "level": "basic",
          "group": "隐私与安全",
          "required": true,
          "default": true
        }
      ]
    }
  ]
}
