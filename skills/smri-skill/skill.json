{
  "schema_version": 1,
  "id": "smri-skill",
  "description": "smri-skill 统筹已登记的独立方法和可复用流程。支持：ANTs Registration；分区影像统计；FSL 脑提取；FSL 组织分割；FSL 非线性配准；FSL 应用形变；ANTs 应用变换；FSL 完整结构预处理（fsl_anat）；其他方法可在详情中分页查询。",
  "method_refs": [
    {
      "capability": "image.registration",
      "method_id": "ants_registration",
      "label": "ANTs Registration",
      "default_recommended": true,
      "default_reason": "需要非线性形变或更高精度跨受试者配准时优先使用。",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "使用 ANTs 完成刚体、仿射或 SyN 非线性配准，并保存复合变换与完整日志。",
      "method_ref": "ants.registration"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "reviewed-roi-stats-dipy-tool",
      "label": "分区影像统计",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [
        "roi-stats",
        "roi-wise-diffusion-features",
        "roi-wise-feature-extraction"
      ],
      "execution_resolution": {},
      "role": "Reference DIPY snippet for atlas-based ROI statistics on tensor metrics。 Inputs: metric: 标量影像 (file); roi: 分区图谱 (file); labels: 标签表 (file). Registered outputs: results/roi_stats.csv.",
      "method_ref": "reviewed.dipy-tool.roi-stats"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "reviewed-bet-fsl-tool",
      "label": "FSL 脑提取",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Extract brain tissue from the input image with FSL BET, controlling the fractional intensity threshold; save the extracted image and BET mask inside the result directory。 Inputs: input: 输入影像 (file). Registered outputs: results/image.nii.gz. Fixed invocation options: --operation bet.",
      "method_ref": "reviewed.fsl-tool.bet"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "reviewed-fast-fsl-tool",
      "label": "FSL 组织分割",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Segment the input brain image into the requested number of tissue classes with FSL FAST; expose the tissue segmentation and preserve additional FAST products in the result directory。 Inputs: input: 输入影像 (file). Registered outputs: results/tissue_seg.nii.gz. Fixed invocation options: --operation fast.",
      "method_ref": "reviewed.fsl-tool.fast"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "reviewed-fnirt-fsl-tool",
      "label": "FSL 非线性配准",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Register an input image nonlinearly to a reference with FSL FNIRT, optionally initialized by a supplied affine matrix; write the warped image and warp coefficients。 Inputs: input: 输入影像 (file); reference: 参考影像 (file); transform: 变换/形变场 (file). Registered outputs: results/image.nii.gz. Fixed invocation options: --operation fnirt.",
      "method_ref": "reviewed.fsl-tool.fnirt"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "reviewed-applywarp-fsl-tool",
      "label": "FSL 应用形变",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Apply an existing FSL warp to the input image on the supplied reference grid, using linear or nearest-neighbour interpolation. This entry does not estimate a new registration。 Inputs: input: 输入影像 (file); reference: 参考影像 (file); transform: 变换/形变场 (file). Registered outputs: results/image.nii.gz. Fixed invocation options: --operation applywarp.",
      "method_ref": "reviewed.fsl-tool.applywarp"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "reviewed-ants-apply-smri-skill",
      "label": "ANTs 应用变换",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Apply an existing ANTs transform to a 3D image on the supplied reference grid with linear or nearest-neighbour interpolation; do not estimate a new transform。 Inputs: input: 输入影像 (file); reference: 参考影像 (file); transform: 变换/形变场 (file). Registered outputs: results/image.nii.gz. Fixed invocation options: --operation ants-apply.",
      "method_ref": "reviewed.smri-skill.ants-apply"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "reviewed-fsl-anat-fsl-tool",
      "label": "FSL 完整结构预处理（fsl_anat）",
      "default_recommended": true,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Invoke the existing FSL fsl_anat workflow on a T1-weighted image and retain its structural.anat directory, including the bias-corrected brain image。 Inputs: input: T1w NIfTI (file). Registered outputs: results/structural.anat/T1_biascorr_brain.nii.gz. Fixed invocation options: --operation fsl-anat.",
      "method_ref": "reviewed.fsl-tool.fsl-anat"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "linked-freesurfer-recon-all",
      "label": "FreeSurfer recon-all（可执行）",
      "default_recommended": false,
      "default_reason": "Choose for anatomical atlas parcellation or cortical/subcortical reconstruction when T1w or a suitable existing FreeSurfer subject is available. Verify stage, space and runtime status; availability is not a completed run.",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "Run FreeSurfer recon-all for T1w cortical surface reconstruction, subcortical segmentation and anatomical atlas parcellation. all runs the full reconstruction; autorecon1/2/3 are consecutive stages, and stats recomputes statistics in an existing subject directory. all/autorecon3 expose mri/aparc+aseg.mgz as a Desikan-Killiany cortical plus subcortical node image, not just a result folder. Labels are in the subject structural space, not automatically aligned to DWI or streamlines. Connectome use requires checking alignment and the atlas lookup table; labelconvert remaps IDs but does not register images. Tissue segmentation, 5TT and data-driven clusters are different products.",
      "method_ref": "freesurfer.recon_all"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "linked-ants_registration",
      "label": "ANTs Registration",
      "default_recommended": false,
      "default_reason": "需要非线性形变或更高精度跨受试者配准时优先使用。",
      "replaces_operations": [],
      "execution_resolution": {},
      "role": "使用 ANTs 完成刚体、仿射或 SyN 非线性配准，并保存复合变换与完整日志。",
      "method_ref": "ants.registration"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "smri-skill-guided--dicom-nifti",
      "label": "dcm2niix 实际转换",
      "default_recommended": false,
      "default_reason": "服务器已检测到 dcm2niix，适合把 DICOM 序列转换为 NIfTI。",
      "replaces_operations": [],
      "execution_resolution": {
        "state": "mapped",
        "reason": "已核对到现有实现；选择具体入口后按其真实输入、参数和输出执行。",
        "source_method_id": "smri-skill-guided--dicom-nifti",
        "target_method_id": "dcm2niix-convert"
      },
      "role": "调用服务器现有 dcm2niix，将只读 DICOM 输入转换到隔离输出目录并生成 JSON sidecar。",
      "method_ref": "dcm2niix.convert"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "smri-skill-guided--organize-to-bids",
      "label": "按用户文件映射整理 BIDS（文件名检查）",
      "default_recommended": false,
      "default_reason": "",
      "replaces_operations": [],
      "execution_resolution": {
        "state": "mapped",
        "reason": "支持显式文件映射整理；完整数据集验证仍需 BIDS Validator CLI，不把文件名检查当作完整验证。",
        "source_method_id": "smri-skill-guided--organize-to-bids",
        "target_method_id": "reviewed-explicit-stage-bids-organizer"
      },
      "role": "Copy files according to an explicit source-relative to BIDS-relative JSON mapping, check destination filenames with BIDSValidator, and write dataset metadata and a staging report. It does not infer missing entities or perform full dataset validation。 Inputs: input: 源数据集目录 (directory); mapping: 显式文件映射 JSON（源相对路径 → BIDS 相对路径） (file). Registered outputs: results/dataset_description.json, results/staging_report.json. Fixed invocation options: --operation stage.",
      "method_ref": "reviewed.bids-organizer.explicit-stage"
    },
    {
      "capability": "skill.smri-skill",
      "method_id": "smri-skill-guided--bids-anatomical-derivatives-standardized",
      "label": "fMRIPrep 本地环境执行",
      "default_recommended": false,
      "default_reason": "配置 LOCALFLOW_FMRIPREP_EXECUTABLE 后可直接运行，不向后端开放 Docker socket。",
      "replaces_operations": [],
      "execution_resolution": {
        "state": "mapped",
        "reason": "已核对到现有实现；选择具体入口后按其真实输入、参数和输出执行。",
        "source_method_id": "smri-skill-guided--bids-anatomical-derivatives-standardized",
        "target_method_id": "fmriprep-local-environment"
      },
      "role": "通过 NeuroClaw 式可执行环境路径运行单个受试者的 fMRIPrep；环境未配置时保留为明确的禁用选项。",
      "method_ref": "fmriprep.run"
    }
  ],
