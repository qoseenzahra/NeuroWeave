{
  "schema_version": 1,
  "manifest_kind": "execution",
  "skill_id": "fmriprep-tool",
  "provides": [
    {
      "capability": "skill.fmriprep-tool",
      "method_id": "fmriprep-local-environment",
      "label": "fMRIPrep 本地环境执行",
      "description": "通过 NeuroClaw 式可执行环境路径运行单个受试者的 fMRIPrep；环境未配置时保留为明确的禁用选项。",
      "runner_id": "fmriprep.run",
      "execution_mode": "runner",
      "input_types": ["dataset_folder"],
      "output_types": ["generated_folder", "execution_log"],
      "default_recommended": true,
      "default_reason": "配置 LOCALFLOW_FMRIPREP_EXECUTABLE 后可直接运行，不向后端开放 Docker socket。",
      "parameters": [
        {"id": "participant_label", "argument": "participant-label", "label": "受试者编号", "description": "只运行一个明确受试者；可输入 01 或 sub-01。", "type": "string", "control": "text", "level": "basic", "group": "运行范围", "required": true, "default": "", "placeholder": "例如 01"},
        {"id": "output_spaces", "argument": "output-spaces", "label": "输出空间", "description": "以空格分隔的 fMRIPrep 输出空间。", "type": "string", "control": "text", "level": "basic", "group": "输出", "required": true, "default": "MNI152NLin2009cAsym T1w"},
        {"id": "run_freesurfer", "argument": "fs-no-reconall", "label": "运行 FreeSurfer", "description": "启用时使用已配置 FreeSurfer license 执行表面重建。", "type": "boolean", "control": "switch", "level": "basic", "group": "表面处理", "required": true, "default": false},
        {"id": "threads", "argument": "nthreads", "label": "总线程数", "description": "NiPype 工作流总线程数。", "type": "integer", "control": "number", "level": "advanced", "group": "计算资源", "required": true, "default": 8, "minimum": 1, "maximum": 128, "step": 1},
        {"id": "omp_threads", "argument": "omp-nthreads", "label": "OMP 线程数", "description": "单个多线程节点使用的线程数。", "type": "integer", "control": "number", "level": "advanced", "group": "计算资源", "required": true, "default": 2, "minimum": 1, "maximum": 64, "step": 1},
        {"id": "memory_gb", "argument": "memory-gb", "label": "内存上限", "description": "换算为 fMRIPrep --mem-mb。", "type": "number", "control": "number", "level": "advanced", "group": "计算资源", "unit": "GB", "required": true, "default": 16, "minimum": 2, "maximum": 1024, "step": 1},
        {"id": "skip_bids_validation", "argument": "skip-bids-validation", "label": "跳过 BIDS Validator", "description": "仅在数据已经独立验证时启用。", "type": "boolean", "control": "switch", "level": "advanced", "group": "输入", "required": true, "default": false}
      ],
      "input_slots": [
        {"id": "bids_dataset", "type": "dataset_folder", "label": "BIDS 数据集", "description": "包含目标受试者功能像和结构像的 BIDS 根目录。", "required": true, "binding": "folder", "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "derivatives", "type": "generated_folder", "label": "fMRIPrep derivatives", "description": "预处理影像、变换、混杂回归量和 HTML 报告。", "primary": true, "path_template": "fmriprep/"},
        {"id": "log", "type": "execution_log", "label": "fMRIPrep 日志", "description": "完整执行输出。", "path_template": "fmriprep.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [{"path": "skills/fmriprep-tool/SKILL.md", "label": "fMRIPrep Skill", "kind": "skill", "line_start": 1}]
    }
  ]
}
