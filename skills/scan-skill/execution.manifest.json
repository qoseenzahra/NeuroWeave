{
  "schema_version": 1,
  "skill_id": "scan-skill",
  "provides": [
    {
      "capability": "skill.scan-skill",
      "method_id": "linked-bids_organizer",
      "label": "BIDS Organizer",
      "description": "把已有 NIfTI/BIDS 数据复制到隔离输出目录，补齐 dataset_description.json、清理敏感 sidecar 字段并执行基础结构校验。DICOM 应先使用 dcm2niix 转换。",
      "runner_id": "bids.prepare",
      "input_types": [
        "dataset_folder",
        "raw_dwi",
        "bids_dwi"
      ],
      "output_types": [
        "bids_dwi",
        "generated_file"
      ],
      "input_slots": [
        {
          "id": "source_dataset",
          "type": "dataset_folder",
          "label": "NIfTI/BIDS 源目录",
          "description": "包含 NIfTI 与可选 BIDS sidecar 的源目录；DICOM 数据请先运行 dcm2niix。",
          "required": true,
          "binding": "folder",
          "source_options": [
            "dataset",
            "existing_path"
          ],
          "validation": [
            "path_exists",
            "inside_authorized_root"
          ]
        }
      ],
      "output_slots": [
        {
          "id": "bids_dataset",
          "type": "bids_dwi",
          "label": "BIDS 数据集副本",
          "description": "经过复制、元数据清理和基础验证的数据集。",
          "primary": true,
          "path_template": "bids/"
        },
        {
          "id": "validation_report",
          "type": "generated_file",
          "label": "BIDS 校验报告",
          "description": "受试者数、影像数、匿名化字段数和结构问题。",
          "path_template": "bids-validation.json"
        }
      ],
      "default_recommended": false,
      "default_reason": "标准化输入可以减少预处理工具之间的差异。",
      "parameters": [
        {
          "id": "validation_level",
          "argument": "validation-level",
          "label": "BIDS 验证级别",
          "description": "严格模式在没有 sub-* 或 NIfTI 时停止；基础模式复制并在报告中记录问题。",
          "type": "string",
          "control": "select",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": "strict",
          "options": [
            {
              "value": "basic",
              "label": "基础检查并保留报告"
            },
            {
              "value": "strict",
              "label": "严格检查，失败即停止"
            }
          ]
        },
        {
          "id": "anonymize_metadata",
          "argument": "anonymize-metadata",
          "label": "清理敏感元数据",
          "description": "只在输出副本中移除常见 Patient、Institution、Physician 和日期字段。",
          "type": "boolean",
          "control": "switch",
          "level": "basic",
          "group": "隐私与安全",
          "required": true,
          "default": true
        }
      ]
    },
    {
      "capability": "skill.scan-skill",
      "method_id": "linked-dataset_inspector",
      "label": "数据集巡检",
      "description": "扫描授权目录的结构和轻量元数据，形成处理前检查摘要。",
      "runner_id": "dataset.inspect",
      "input_types": [
        "dataset_folder"
      ],
      "output_types": [
        "dataset_profile"
      ],
      "default_recommended": false,
      "default_reason": "所有后续方法都需要先确认输入条件。",
      "parameters": [
        {
          "id": "inspection_scope",
          "argument": "inspection-scope",
          "label": "巡检范围",
          "description": "控制只检查结构，还是进一步读取轻量影像头和元数据。",
          "type": "string",
          "control": "select",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": "metadata",
          "options": [
            {
              "value": "structure",
              "label": "仅目录结构"
            },
            {
              "value": "metadata",
              "label": "结构与元数据"
            },
            {
              "value": "headers",
              "label": "包含影像头"
            }
          ]
        },
        {
          "id": "bids_validation",
          "argument": "bids-validation",
          "label": "检查 BIDS 规范",
          "description": "检测 BIDS 结构、命名和关键 sidecar。",
          "type": "boolean",
          "control": "switch",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": true,
          "options": [
            {
              "value": true,
              "label": "检查"
            },
            {
              "value": false,
              "label": "跳过"
            }
          ]
        },
        {
          "id": "max_files",
          "argument": "max-files",
          "label": "最大检查文件数",
          "description": "限制深度巡检读取的文件数量，0 表示不限制。",
          "type": "integer",
          "control": "number",
          "level": "advanced",
          "group": "扫描限制",
          "required": true,
          "default": 10000,
          "minimum": 0,
          "maximum": 10000000,
          "step": 100,
          "options": []
        },
        {
          "id": "follow_links",
          "argument": "follow-links",
          "label": "跟随符号链接",
          "description": "是否进入数据目录中的符号链接目标。",
          "type": "boolean",
          "control": "switch",
          "level": "advanced",
          "group": "扫描限制",
          "required": true,
          "default": false,
          "options": [
            {
              "value": true,
              "label": "跟随"
            },
            {
              "value": false,
              "label": "不跟随"
            }
          ]
        },
        {
          "id": "compute_checksums",
          "argument": "compute-checksums",
          "label": "计算校验和",
          "description": "为文件生成校验和；大型数据集会显著增加巡检时间。",
          "type": "boolean",
          "control": "switch",
          "level": "advanced",
          "group": "完整性",
          "required": true,
          "default": false,
          "options": [
            {
              "value": true,
              "label": "计算"
            },
            {
              "value": false,
              "label": "不计算"
            }
          ]
        },
        {
          "id": "sample_subjects",
          "argument": "sample-subjects",
          "label": "头信息抽样数",
          "description": "读取影像头时抽样的受试者数量。",
          "type": "integer",
          "control": "number",
          "level": "advanced",
          "group": "完整性",
          "required": true,
          "default": 5,
          "minimum": 1,
          "maximum": 1000,
          "step": 1,
          "visible_when": {
            "inspection_scope": [
              "headers"
            ]
          },
          "options": []
        }
      ]
    },
    {
      "capability": "skill.scan-skill",
      "method_id": "linked-dcm2niix-convert",
      "label": "dcm2niix 实际转换",
      "description": "调用服务器现有 dcm2niix，将只读 DICOM 输入转换到隔离输出目录并生成 JSON sidecar。",
      "runner_id": "dcm2niix.convert",
      "execution_mode": "runner",
      "input_types": [
        "dataset_folder"
      ],
      "output_types": [
        "generated_folder",
        "execution_log"
      ],
      "default_recommended": false,
      "default_reason": "服务器已检测到 dcm2niix，适合把 DICOM 序列转换为 NIfTI。",
      "parameters": [
        {
          "id": "compression",
          "argument": "-z",
          "label": "压缩方式",
          "description": "y 使用 gzip 压缩；n 输出未压缩 NIfTI；i 使用内部压缩。",
          "type": "string",
          "control": "select",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": "y",
          "options": [
            {
              "value": "y",
              "label": "GZip"
            },
            {
              "value": "n",
              "label": "不压缩"
            },
            {
              "value": "i",
              "label": "内部压缩"
            }
          ]
        },
        {
          "id": "bids_sidecar",
          "argument": "-b",
          "label": "生成 BIDS JSON",
          "description": "为每个序列输出包含采集元数据的 JSON sidecar。",
          "type": "boolean",
          "control": "switch",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": true
        },
        {
          "id": "anonymize",
          "argument": "-ba",
          "label": "匿名化 sidecar",
          "description": "移除 dcm2niix 支持匿名化的个人标识字段。",
          "type": "boolean",
          "control": "switch",
          "level": "advanced",
          "group": "隐私",
          "required": true,
          "default": true
        },
        {
          "id": "filename_template",
          "argument": "-f",
          "label": "文件名模板",
          "description": "dcm2niix 文件名占位符；不允许路径分隔符或上级目录。",
          "type": "string",
          "control": "text",
          "level": "advanced",
          "group": "输出命名",
          "required": true,
          "default": "%p_%s",
          "placeholder": "%p_%s"
        }
      ],
      "input_slots": [
        {
          "id": "dicom_directory",
          "type": "dataset_folder",
          "label": "DICOM 目录",
          "description": "包含一个或多个 DICOM 序列的目录；源目录只读。",
          "required": true,
          "binding": "folder",
          "source_options": [
            "dataset",
            "existing_path"
          ],
          "validation": [
            "path_exists",
            "within_authorized_root"
          ]
        }
      ],
      "output_slots": [
        {
          "id": "converted",
          "type": "generated_folder",
          "label": "NIfTI 转换目录",
          "description": "转换后的 NIfTI、JSON 与扩散梯度文件。",
          "primary": true,
          "path_template": "converted-nifti/"
        },
        {
          "id": "log",
          "type": "execution_log",
          "label": "转换日志",
          "description": "dcm2niix 完整输出。",
          "path_template": "dcm2niix.log"
        }
      ],
      "structure_level": "reviewed",
      "source_references": [
        {
          "path": "skills/dcm2nii/SKILL.md",
          "label": "dcm2nii Skill",
          "kind": "skill",
          "line_start": 1
        }
      ]
    }
  ]
}
