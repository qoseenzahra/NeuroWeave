{
  "schema_version": 1,
  "skill_id": "dataset-inspector",
  "provides": [{
    "capability": "dwi.inspect", "method_id": "dataset_inspector", "label": "数据集巡检",
    "description": "扫描授权目录的结构和轻量元数据，形成处理前检查摘要。",
    "runner_id": "dataset.inspect", "input_types": ["dataset_folder"], "output_types": ["dataset_profile"],
    "default_recommended": true, "default_reason": "所有后续方法都需要先确认输入条件。", "parameters": [
      {"id": "inspection_scope", "argument": "inspection-scope", "label": "巡检范围", "description": "控制只检查结构，还是进一步读取轻量影像头和元数据。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "metadata", "options": [{"value": "structure", "label": "仅目录结构"}, {"value": "metadata", "label": "结构与元数据"}, {"value": "headers", "label": "包含影像头"}]},
      {"id": "bids_validation", "argument": "bids-validation", "label": "检查 BIDS 规范", "description": "检测 BIDS 结构、命名和关键 sidecar。", "type": "boolean", "control": "switch", "level": "basic", "group": "常用参数", "required": true, "default": true, "options": [{"value": true, "label": "检查"}, {"value": false, "label": "跳过"}]},
      {"id": "max_files", "argument": "max-files", "label": "最大检查文件数", "description": "限制深度巡检读取的文件数量，0 表示不限制。", "type": "integer", "control": "number", "level": "advanced", "group": "扫描限制", "required": true, "default": 10000, "minimum": 0, "maximum": 10000000, "step": 100, "options": []},
      {"id": "follow_links", "argument": "follow-links", "label": "跟随符号链接", "description": "是否进入数据目录中的符号链接目标。", "type": "boolean", "control": "switch", "level": "advanced", "group": "扫描限制", "required": true, "default": false, "options": [{"value": true, "label": "跟随"}, {"value": false, "label": "不跟随"}]},
      {"id": "compute_checksums", "argument": "compute-checksums", "label": "计算校验和", "description": "为文件生成校验和；大型数据集会显著增加巡检时间。", "type": "boolean", "control": "switch", "level": "advanced", "group": "完整性", "required": true, "default": false, "options": [{"value": true, "label": "计算"}, {"value": false, "label": "不计算"}]},
      {"id": "sample_subjects", "argument": "sample-subjects", "label": "头信息抽样数", "description": "读取影像头时抽样的受试者数量。", "type": "integer", "control": "number", "level": "advanced", "group": "完整性", "required": true, "default": 5, "minimum": 1, "maximum": 1000, "step": 1, "visible_when": {"inspection_scope": ["headers"]}, "options": []}
    ]
  }]
}
