{
  "schema_version": 1,
  "manifest_kind": "execution",
  "skill_id": "table-cleaning",
  "provides": [
    {
      "capability": "skill.table-cleaning",
      "method_id": "pandas-clean",
      "label": "Pandas 表格清洗",
      "description": "在只读输入和隔离输出目录下清理缺失值、重复行、空白字符与列名，并生成审计报告。",
      "runner_id": "table.clean",
      "execution_mode": "runner",
      "input_types": ["dataset_folder", "analysis_input"],
      "output_types": ["generated_file", "execution_log"],
      "default_recommended": true,
      "default_reason": "适合 CSV/TSV/XLSX 的可复现基础清洗，不覆盖原文件。",
      "parameters": [
        {"id": "missing_strategy", "argument": "missing-strategy", "label": "缺失值策略", "description": "保留、删除行列或使用统计量/常量填充。", "type": "string", "control": "select", "level": "basic", "group": "常用参数", "required": true, "default": "keep", "options": [{"value": "keep", "label": "保留"}, {"value": "drop_rows", "label": "按阈值删除行"}, {"value": "drop_columns", "label": "按阈值删除列"}, {"value": "mean", "label": "数值列均值填充"}, {"value": "median", "label": "数值列中位数填充"}, {"value": "mode", "label": "众数填充"}, {"value": "constant", "label": "常量填充"}]},
        {"id": "deduplicate", "argument": "deduplicate", "label": "删除重复行", "description": "删除所有列完全相同的重复记录。", "type": "boolean", "control": "switch", "level": "basic", "group": "常用参数", "required": true, "default": true},
        {"id": "strip_whitespace", "argument": "strip-whitespace", "label": "清理文本空白", "description": "去除文本单元格首尾空白。", "type": "boolean", "control": "switch", "level": "basic", "group": "常用参数", "required": true, "default": true},
        {"id": "missing_threshold", "argument": "missing-threshold", "label": "允许缺失比例", "description": "删除行/列模式下允许的最大缺失比例。", "type": "number", "control": "number", "level": "advanced", "group": "缺失值", "required": true, "default": 1.0, "minimum": 0, "maximum": 1, "step": 0.05},
        {"id": "fill_value", "argument": "fill-value", "label": "填充常量", "description": "missing_strategy=constant 时使用。", "type": "string", "control": "text", "level": "advanced", "group": "缺失值", "required": false, "default": "", "visible_when": {"missing_strategy": ["constant"]}},
        {"id": "normalize_columns", "argument": "normalize-columns", "label": "规范化列名", "description": "把列名转换为小写 snake_case，并安全处理重复列名。", "type": "boolean", "control": "switch", "level": "advanced", "group": "列名", "required": true, "default": false}
      ],
      "input_slots": [
        {"id": "table", "type": "analysis_input", "label": "输入表格", "description": "CSV、TSV、XLSX 或 XLS 文件。", "required": true, "binding": "file", "formats": [".csv", ".tsv", ".xlsx", ".xls"], "source_options": ["dataset", "existing_path", "upstream_output"], "validation": ["path_exists"]}
      ],
      "output_slots": [
        {"id": "cleaned", "type": "generated_file", "label": "清洗后表格", "description": "统一输出为 UTF-8 CSV，不覆盖原表格。", "primary": true, "path_template": "cleaned.csv"},
        {"id": "report", "type": "generated_file", "label": "清洗报告", "description": "行列数、缺失值、重复值、数据类型与参数快照。", "path_template": "cleaning-report.json"},
        {"id": "log", "type": "execution_log", "label": "清洗日志", "description": "完整执行输出。", "path_template": "table-cleaning.log"}
      ],
      "structure_level": "reviewed",
      "source_references": [{"path": "skills/table-cleaning/SKILL.md", "label": "Table Cleaning Skill", "kind": "skill", "line_start": 1}]
    }
  ]
}
