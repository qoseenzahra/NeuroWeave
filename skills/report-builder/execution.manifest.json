{
  "schema_version": 1,
  "skill_id": "report-builder",
  "provides": [
    {
      "capability": "skill.report-builder",
      "method_id": "linked-report_builder",
      "label": "结果报告",
      "description": "生成可审阅的处理摘要、参数快照与结果清单。",
      "runner_id": "report.build",
      "input_types": [
        "*"
      ],
      "output_types": [
        "processing_report"
      ],
      "output_slots": [
        {
          "id": "report",
          "type": "generated_file",
          "label": "处理报告",
          "description": "包含流程、参数、输入绑定、Dry-run 与环境快照的 HTML、Markdown 或 JSON 文件。",
          "primary": true,
          "path_template": "localflow-report.{format}"
        }
      ],
      "default_recommended": false,
      "default_reason": "保留流程、参数和 QC 的可追溯记录。",
      "parameters": [
        {
          "id": "detail_level",
          "argument": "detail-level",
          "label": "报告详细程度",
          "description": "控制报告包含摘要、标准细节或完整诊断信息。",
          "type": "string",
          "control": "select",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": "standard",
          "options": [
            {
              "value": "summary",
              "label": "摘要"
            },
            {
              "value": "standard",
              "label": "标准"
            },
            {
              "value": "diagnostic",
              "label": "完整诊断"
            }
          ]
        },
        {
          "id": "include_qc",
          "argument": "include-qc",
          "label": "包含质量控制",
          "description": "汇总每个步骤产生的 QC 指标、警告和图表引用。",
          "type": "boolean",
          "control": "switch",
          "level": "basic",
          "group": "常用参数",
          "required": true,
          "default": true,
          "options": [
            {
              "value": true,
              "label": "包含"
            },
            {
              "value": false,
              "label": "不包含"
            }
          ]
        },
        {
          "id": "output_format",
          "argument": "output-format",
          "label": "输出格式",
          "description": "生成 HTML、Markdown 或 JSON 结构化报告。",
          "type": "string",
          "control": "select",
          "level": "advanced",
          "group": "输出",
          "required": true,
          "default": "html",
          "options": [
            {
              "value": "html",
              "label": "HTML"
            },
            {
              "value": "markdown",
              "label": "Markdown"
            },
            {
              "value": "json",
              "label": "JSON"
            }
          ]
        },
        {
          "id": "include_commands",
          "argument": "include-commands",
          "label": "包含命令与参数",
          "description": "在报告中记录命令预览和完整参数快照。",
          "type": "boolean",
          "control": "switch",
          "level": "advanced",
          "group": "可复现性",
          "required": true,
          "default": true,
          "options": [
            {
              "value": true,
              "label": "包含"
            },
            {
              "value": false,
              "label": "不包含"
            }
          ]
        },
        {
          "id": "include_environment",
          "argument": "include-environment",
          "label": "包含环境信息",
          "description": "记录软件版本、容器或 Conda 环境摘要。",
          "type": "boolean",
          "control": "switch",
          "level": "advanced",
          "group": "可复现性",
          "required": true,
          "default": true,
          "options": [
            {
              "value": true,
              "label": "包含"
            },
            {
              "value": false,
              "label": "不包含"
            }
          ]
        },
        {
          "id": "anonymize_paths",
          "argument": "anonymize-paths",
          "label": "匿名化本地路径",
          "description": "从导出的报告中移除用户名和绝对目录前缀。",
          "type": "boolean",
          "control": "switch",
          "level": "advanced",
          "group": "隐私",
          "required": true,
          "default": true,
          "options": [
            {
              "value": true,
              "label": "匿名化"
            },
            {
              "value": false,
              "label": "保留完整路径"
            }
          ]
        }
      ]
    }
  ]
}
